rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - Allow read and write for registration, profiles, and sync
    match /users/{userId} {
      allow read, write: if true;
    }

    // Credentials collection - Allow profile credentials sync & authentication
    match /credentials/{userId} {
      allow read, write: if true;
    }

    // Prayer requests collection - Public prayer requests, comments, prayer counters
    match /prayers/{prayerId} {
      allow read, write: if true;
    }

    // Mission reports collection - Missionary dispatches, likes, updates
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Events and live watches collection - Global summits, video watch rsvps
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Real-time Chatroom messages
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }

    // Site settings & Branding customizer
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Audit logs & Activity monitoring
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Default fallback rule for any collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
